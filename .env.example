# Copy to .env and fill in as needed. Every variable is optional: with none of
# them set, the pipeline runs end to end on clearly-labelled sample data.
#
# Nothing in this file is read outside eq_report/config.py, and credentials are
# never written to logs or to the run manifest.

# --- output and storage ----------------------------------------------------
EQR_OUTPUT_DIR=output
EQR_DB_PATH=output/evidence.sqlite3

# --- logging ---------------------------------------------------------------
EQR_LOG_LEVEL=INFO
EQR_LOG_JSON=false

# --- provider behaviour ----------------------------------------------------
# Set to false to make the pipeline refuse to run rather than fall back to the
# mock providers. Useful once real providers are wired up.
EQR_ALLOW_MOCK_PROVIDERS=true
EQR_PROVIDER_TIMEOUT_SECONDS=20

# --- market data (the one generic HTTP provider seam wired up so far) ------
# Only used as a fallback when Megadata is not configured.
# EQR_MARKET_DATA_API_KEY=
# EQR_MARKET_DATA_BASE_URL=https://api.example.com/v1

# --- fundamentals (interface exists; no generic HTTP vendor wired up yet) ---
# EQR_FUNDAMENTALS_API_KEY=
# EQR_FUNDAMENTALS_BASE_URL=

# --- documents (interface exists; no generic HTTP vendor wired up yet) -----
# EQR_DOCUMENTS_API_KEY=
# EQR_DOCUMENTS_BASE_URL=
# SEC EDGAR requires a descriptive User-Agent rather than an API key. Also
# used by document providers when they fetch filing text.
# EQR_SEC_USER_AGENT=Your Name your.email@example.com

# Use public Yahoo Finance and SEC EDGAR sources for the supported live-web
# adapter (currently AAPL only). Opt-in: public endpoints may be rate-limited.
# EQR_ONLINE_SOURCES=false

# --- MegadataAPI (primary real-data provider for all three branches) -------
# e.g. http://192.168.1.16:8080
# EQR_MEGADATA_BASE_URL=
# For HTTP Basic authentication:
# EQR_MEGADATA_USERNAME=
# EQR_MEGADATA_PASSWORD=
# Alternatively, for a Bearer-token deployment:
# EQR_MEGADATA_API_KEY=

# --- model configuration ---------------------------------------------------
# When EQR_MODEL_API_KEY is set, this model backs every LLM stage of the
# pipeline: planning, normalisation, analytics cross-checks, every segment
# agent, synthesis and QA. There is no more per-stage opt-in - every stage
# always uses the LLM path when a key is configured. Each stage still keeps
# its original deterministic logic internally as a verification/fallback:
# numeric output is cross-checked against it (and corrected if it disagrees),
# and it is what runs if the LLM call itself fails or no key is set at all.
EQR_MODEL_PROVIDER=openrouter
EQR_MODEL_NAME=openai/gpt-5
EQR_MODEL_BASE_URL=https://openrouter.ai/api/v1
EQR_MODEL_MAX_TOKENS=16000
EQR_MODEL_TEMPERATURE=0.0
# EQR_MODEL_API_KEY=
# EQR_MODEL_APP_URL=
EQR_MODEL_APP_NAME=EQ Report

# Planning-only reasoning effort override ("high" | "medium" | "low"). Sent as
# OpenRouter's {"reasoning": {"effort": ...}} on the planning call alone -
# same model, told to think harder on the one call that shapes every
# downstream stage's scope. Every other stage keeps using EQR_MODEL_NAME as
# configured above, at its default reasoning effort. Unset by default.
# EQR_PLANNING_REASONING_EFFORT=high

# --- live web research for data gaps (opt-in; extra cost per run) ----------
# When true (and a model is configured), the pipeline asks the model - with
# OpenRouter's web-search plugin - to find a real, dated, source-linked answer
# for each of the report's disclosed data gaps, up to EQR_RESEARCH_DATA_GAPS_MAX
# of them. A gap is only filled if a real URL comes back; anything else is
# left as an unresolved gap. Filled gaps get their own "Additional Research
# (Web-Verified)" section and are struck from the disclosed gap list. Off by
# default because it is a genuine extra cost (one additional model call per
# gap) beyond whatever the model is already configured for.
EQR_RESEARCH_DATA_GAPS=false
EQR_RESEARCH_DATA_GAPS_MAX=8

# --- live data-freshness check (opt-in; extra cost per run) ----------------
# When true (and a model is configured), one call - before analysis or
# synthesis run - asks the model to verify, via live web search, the most
# recent fiscal period this company has actually reported. A mismatch against
# what the configured providers gave the pipeline prints a prominent banner
# on page 1 and a QA warning; it does not attempt to replace the dataset (see
# pipeline/freshness_check.py for why). Off by default: another genuine extra
# cost, separate from EQR_RESEARCH_DATA_GAPS.
EQR_CHECK_DATA_FRESHNESS=false

# Copy to .env and fill in as needed. MegadataAPI is the sole data provider;
# without its base URL the acquisition stage records a configuration failure.
#
# Nothing in this file is read outside eq_report/config.py, and credentials are
# never written to logs or to the run manifest.

# --- output and storage ----------------------------------------------------
EQR_OUTPUT_DIR=output
EQR_DB_PATH=output/evidence.sqlite3

# --- logging ---------------------------------------------------------------
EQR_LOG_LEVEL=INFO
EQR_LOG_JSON=false

# --- provider behaviour ----------------------------------------------------
EQR_PROVIDER_TIMEOUT_SECONDS=20

# --- MegadataAPI (primary real-data provider for all three branches) -------
# e.g. http://192.168.1.16:8080
# EQR_MEGADATA_BASE_URL=
# For HTTP Basic authentication:
# EQR_MEGADATA_USERNAME=
# EQR_MEGADATA_PASSWORD=
# Alternatively, for a Bearer-token deployment:
# EQR_MEGADATA_API_KEY=

# --- model configuration ---------------------------------------------------
# When EQR_MODEL_API_KEY is set, this model backs every LLM stage of the
# pipeline: planning, normalisation, analytics cross-checks, every segment
# agent, synthesis and QA. There is no more per-stage opt-in - every stage
# always uses the LLM path when a key is configured. Each stage still keeps
# its original deterministic logic internally as a verification/fallback:
# numeric output is cross-checked against it (and corrected if it disagrees),
# and it is what runs if the LLM call itself fails or no key is set at all.
EQR_MODEL_PROVIDER=openrouter
EQR_MODEL_NAME=openai/gpt-5
EQR_MODEL_BASE_URL=https://openrouter.ai/api/v1
EQR_MODEL_MAX_TOKENS=16000
EQR_MODEL_TEMPERATURE=0.0
# EQR_MODEL_API_KEY=
# EQR_MODEL_APP_URL=
EQR_MODEL_APP_NAME=EQ Report

# Cost controls for the 8 segment agents specifically. They only select and
# phrase from evidence they are shown (validated post hoc), so they don't
# need the same model/quality as planning or synthesis.
# - EQR_MODEL_NAME_AGENTS: a cheaper/faster model for agent calls only.
#   Unset means agents use EQR_MODEL_NAME like every other stage.
# EQR_MODEL_NAME_AGENTS=openai/gpt-5-mini
# - EQR_DETERMINISTIC_SEGMENTS: comma-separated segment names that run their
#   rule-based implementation instead of the LLM writer - no LLM call, no
#   evidence-pool cost, and they still produce real evidence-cited prose (see
#   agents/financial_performance.py). Defaults to the three fact-heavy
#   segments below; set to "" to route every segment through the LLM.
EQR_DETERMINISTIC_SEGMENTS=company_snapshot,financial_performance,operating_drivers

# Planning-only reasoning effort override ("high" | "medium" | "low"). Sent as
# OpenRouter's {"reasoning": {"effort": ...}} on the planning call alone -
# same model, told to think harder on the one call that shapes every
# downstream stage's scope. Every other stage keeps using EQR_MODEL_NAME as
# configured above, at its default reasoning effort. Unset by default.
# EQR_PLANNING_REASONING_EFFORT=high

# --- live data-freshness check (opt-in; extra cost per run) ----------------
# When true (and a model is configured), one call - before analysis or
# synthesis run - asks the model to verify, via live web search, the most
# recent fiscal period this company has actually reported. A mismatch against
# what the configured providers gave the pipeline prints a prominent banner
# on page 1 and a QA warning; it does not attempt to replace the dataset (see
# pipeline/freshness_check.py for why). Off by default: another genuine extra
# cost.
EQR_CHECK_DATA_FRESHNESS=false

# --- live verification of genuine source conflicts (opt-in; extra cost) ---
# When two providers disagree on the same metric, the model may only unblock
# it after web search finds a dated source that matches one candidate. The
# matched row is recorded as the canonical fact with the verification URL;
# anything unverified remains blocked for manual review.
EQR_VERIFY_METRIC_CONFLICTS=false

# --- live web research to fill thin sections (opt-in; extra cost per run) --
# When a section (company snapshot, financials, operating drivers, catalysts)
# has too little MegadataAPI evidence to write, one search call proposes
# up to a few factual claims from reputable sources only (see the domain
# allow-list below), and a second, independent call must confirm each one
# via its own live search before it is written to the Evidence Store as
# ordinary, citable document evidence. Off by default: another genuine extra
# cost, and it only ever runs for a section that is genuinely thin.
EQR_WEB_FILL_GAPS=false
EQR_WEB_FILL_ALLOWED_DOMAINS=sec.gov,prnewswire.com,businesswire.com,globenewswire.com,reuters.com,bloomberg.com,wsj.com,ft.com,apnews.com
EQR_WEB_FILL_MAX_CLAIMS=12

# --- same-run QA self-repair -----------------------------------------------
# The LLM may rewrite unsupported prose; deterministic QA always reruns and
# alone decides whether publication is safe. If rewriting fails, a localized
# unsupported statement is omitted. Evidence/arithmetic failures still block.
EQR_QA_AUTO_REPAIR=true
EQR_QA_AUTO_REPAIR_MAX_ATTEMPTS=2
